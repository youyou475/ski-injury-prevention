{
  "nodes": {
    "00_intro": {
      "segments": [
        {
          "t": 3.14,
          "dur": 12.7,
          "text": "随着2022年北京冬奥会日益临近，中国大江南北、长城内外，越来越多的人走上冰雪场地，感受冰雪运动的乐趣。"
        },
        {
          "t": 21.19,
          "dur": 16.725,
          "text": "但是冰雪运动也是人们受伤比较多的运动项目，如何防止滑雪运动受伤呢？"
        },
        {
          "t": 37.915,
          "dur": 16.675,
          "text": "大家好，我是本次的滑雪教练，欢迎大家来到吉林市北山四季越野滑雪场。滑雪运动能让你享受自由滑行的乐趣，但是初学滑雪没有经过系统性培训，很容易受伤。"
        },
        {
          "t": 55.14,
          "dur": 6.475,
          "text": "为了减少和避免大家在滑雪运动中发生损伤的几率，让大家更好地参与到滑雪运动中来。"
        },
        {
          "t": 61.72,
          "dur": 10.25,
          "text": "我们深入分析了滑雪运动损伤的类型和原因，其中肌肉拉伤、关节扭伤、骨折、冻伤是最常见的几种滑雪运动损伤类型。"
        },
        {
          "t": 72.96,
          "dur": 11.2,
          "text": "如果不加以科学预防，不仅会带来不好的滑雪体验，还会对身心造成不良的影响。"
        }
      ]
    },
    "01_gear": {
      "segments": [
        {
          "t": 0.17,
          "dur": 10.55,
          "text": "其实我们正常的雪服雪具就可以保护我们身体的踝关节、肩关节、颈关节等绝大多数关节。"
        },
        {
          "t": 11.42,
          "dur": 2.0,
          "text": "但是这还是远远不够的。"
        },
        {
          "t": 14.43,
          "dur": 5.675,
          "text": "护膝、护肘可以专业保护我们的膝关节和肘关节。"
        },
        {
          "t": 21.04,
          "dur": 7.375,
          "text": "但是要注意的是，在选择护膝护肘时，不要选择像这种硬质的护膝。"
        },
        {
          "t": 29.28,
          "dur": 3.55,
          "text": "而要选择可以穿在衣内的软壳护膝。"
        },
        {
          "t": 33.94,
          "dur": 11.1,
          "text": "这种护膝既不妨碍我们滑雪时做出动作，又可以有效防护身体摔伤时导致的关节扭伤。"
        },
        {
          "t": 47.38,
          "dur": 3.975,
          "text": "髋关节对于人体起着承上启下的作用。"
        },
        {
          "t": 52.06,
          "dur": 7.2,
          "text": "大多数人在滑雪时往往都会忽略髋关节的保护，这是非常大的滑雪隐患。"
        },
        {
          "t": 60.02,
          "dur": 3.225,
          "text": "穿戴专业的滑雪护臀，也就是内甲，是对髋关节最好的保护。"
        },
        {
          "t": 63.94,
          "dur": 7.625,
          "text": "这就是我们滑雪时经常可以选择的内甲，也就是我们的护臀。"
        }
      ]
    },
    "02_warmup_offseason": {
      "segments": [
        {
          "t": 0.86,
          "dur": 9.525,
          "text": "在我们滑雪的过程中，最频繁也是要求最高的肌肉群，就是我们的大腿肌肉群和我们的核心肌肉群。"
        },
        {
          "t": 11.24,
          "dur": 6.725,
          "text": "因此，我们给大家推荐了以下三种训练方法，供大家在非雪季也能进行训练。"
        },
        {
          "t": 18.66,
          "dur": 0.35,
          "text": "动作一："
        },
        {
          "t": 19.92,
          "dur": 0.7,
          "text": "靠墙静蹲。"
        },
        {
          "t": 21.65,
          "dur": 3.475,
          "text": "身体背部贴于墙面，收紧核心。"
        },
        {
          "t": 25.9,
          "dur": 3.05,
          "text": "两脚与肩同宽，脚尖朝前。"
        },
        {
          "t": 29.82,
          "dur": 6.15,
          "text": "两手伸直平行于地面，双眼目视前方，保持30秒。"
        },
        {
          "t": 37.9,
          "dur": 0.85,
          "text": "动作二：平板支撑。"
        },
        {
          "t": 39.5,
          "dur": 7.8,
          "text": "两臂与肩同宽，肩膀和肘关节垂直于地面，躯干伸直，两脚尖着地。"
        },
        {
          "t": 48.0,
          "dur": 3.725,
          "text": "注意动作不要变形，身体要保持静止，整个过程保持30秒。"
        },
        {
          "t": 52.82,
          "dur": 2.65,
          "text": "动作三：弓步蹲。"
        },
        {
          "t": 59.7,
          "dur": 4.25,
          "text": "将身体重心摆在躯干和后脚上。"
        },
        {
          "t": 64.72,
          "dur": 8.55,
          "text": "身体保持中立，后脚尽量不要跪地，这时身体最理想的情况下会出现四个90°。"
        },
        {
          "t": 74.32,
          "dur": 3.575,
          "text": "这四个90°分别为脚踝90°、"
        },
        {
          "t": 78.76,
          "dur": 1.925,
          "text": "大腿膝盖内侧90°、"
        },
        {
          "t": 82.01,
          "dur": 7.7,
          "text": "身体上半身与大腿的夹角为90°，还有后腿膝盖内侧90°。"
        },
        {
          "t": 91.02,
          "dur": 2.625,
          "text": "整个过程保持30秒。"
        },
        {
          "t": 94.47,
          "dur": 3.25,
          "text": "我们每天可以练习6组，每两组为一个循环。"
        }
      ]
    },
    "03_warmup_chest": {
      "segments": [
        {
          "t": 1.08,
          "dur": 8.35,
          "text": "滑雪前科学的热身运动是十分必要的，需要让身体的每一大块肌肉群都兴奋起来。"
        },
        {
          "t": 10.26,
          "dur": 3.3,
          "text": "以下几个动作可以帮助大家有效热身。"
        },
        {
          "t": 14.66,
          "dur": 1.725,
          "text": "动作一：扩胸运动。"
        },
        {
          "t": 18.14,
          "dur": 6.425,
          "text": "扩胸运动可以有效地活动我们的胸肌和我们的背阔肌。"
        },
        {
          "t": 26.78,
          "dur": 1.975,
          "text": "接下来请看动作示范。"
        },
        {
          "t": 29.82,
          "dur": 21.25,
          "text": "（跟随教练示范，跟随口令完整完成两组八拍动作）"
        }
      ]
    },
    "04_joint_mobilization": {
      "segments": [
        {
          "t": 0.0,
          "dur": 8.65,
          "text": "滑雪前一定不能忘记活动身体的各个关节，这就是保护身体关节最高效最有效的方法。"
        },
        {
          "t": 9.24,
          "dur": 5.225,
          "text": "下面我就教给大家几种热身关节的方法。"
        }
      ]
    },
    "05_wrist_ankle": {
      "segments": [
        {
          "t": 0.0,
          "dur": 0.4,
          "text": "动作二："
        },
        {
          "t": 1.52,
          "dur": 1.675,
          "text": "活动我们的手腕脚腕。"
        },
        {
          "t": 4.64,
          "dur": 2.975,
          "text": "活动手腕脚腕可以保护我们的"
        },
        {
          "t": 8.58,
          "dur": 2.175,
          "text": "腕关节和踝关节。"
        },
        {
          "t": 13.21,
          "dur": 1.55,
          "text": "下面请看动作示范。"
        },
        {
          "t": 34.78,
          "dur": 2.25,
          "text": "关于活动手腕脚腕的动作要领："
        },
        {
          "t": 37.76,
          "dur": 5.85,
          "text": "要按顺时针和逆时针分别活动、进行转圈。"
        }
      ]
    },
    "06_shoulder": {
      "segments": [
        {
          "t": 0.05,
          "dur": 1.65,
          "text": "动作三：活动肩关节。"
        },
        {
          "t": 2.66,
          "dur": 1.45,
          "text": "下面请看动作示范。"
        },
        {
          "t": 5.87,
          "dur": 10.25,
          "text": "（跟随教练示范完成肩关节绕环）"
        },
        {
          "t": 18.08,
          "dur": 1.95,
          "text": "在我们活动肩关节时，"
        },
        {
          "t": 20.88,
          "dur": 4.775,
          "text": "左脚要向左迈出一步，约与肩同宽，上体保持正直。"
        },
        {
          "t": 29.52,
          "dur": 2.8,
          "text": "我们的手要放到我们的肩窝处，"
        },
        {
          "t": 33.18,
          "dur": 2.25,
          "text": "而后旋转。"
        }
      ]
    },
    "07_knee": {
      "segments": [
        {
          "t": 0.37,
          "dur": 1.625,
          "text": "动作四：颈关节。"
        },
        {
          "t": 4.48,
          "dur": 2.4,
          "text": "颈关节分四步，下面请看动作示范。"
        },
        {
          "t": 31.13,
          "dur": 8.2,
          "text": "在做颈关节时要注意，颈关节是静态拉伸，全程要保持静止。"
        },
        {
          "t": 41.48,
          "dur": 1.75,
          "text": "在我们活动关节时，"
        },
        {
          "t": 44.77,
          "dur": 3.2,
          "text": "每组动作要活动30秒。"
        }
      ]
    },
    "08_hip_rotation": {
      "segments": [
        {
          "t": 1.1,
          "dur": 2.7,
          "text": "动作一：站姿髋关节旋转。"
        },
        {
          "t": 5.14,
          "dur": 5.15,
          "text": "站姿髋关节旋转可以有效地活动我们的髋关节。"
        },
        {
          "t": 11.93,
          "dur": 2.625,
          "text": "下面我就为大家做动作示范。"
        },
        {
          "t": 18.78,
          "dur": 8.2,
          "text": "在髋关节运动时要注意上体保持正直，收紧核心，手可以扶墙面。"
        },
        {
          "t": 28.18,
          "dur": 4.525,
          "text": "腿部要伸直成一条直线，而后画圈。"
        }
      ]
    },
    "09_leg_abduction": {
      "segments": [
        {
          "t": 0.33,
          "dur": 1.475,
          "text": "动作三：腿部外展。"
        },
        {
          "t": 2.52,
          "dur": 5.425,
          "text": "腿部外展可以有效地活动我们大腿的肌肉群，请看动作示范。"
        },
        {
          "t": 8.7,
          "dur": 12.95,
          "text": "（跟随教练示范完成腿部外展）"
        },
        {
          "t": 23.14,
          "dur": 6.925,
          "text": "在我们做这个动作时要注意，上体要保持正直，核心要收紧。"
        },
        {
          "t": 30.74,
          "dur": 7.575,
          "text": "两臂可以展开，也可以伸直放下；抬腿时大腿要与地面平行，大腿外展时要尽量向外打开。"
        },
        {
          "t": 43.5,
          "dur": 7.475,
          "text": "以上三种动作多为八拍一组，做6到8组即可达到热身的目的。"
        }
      ]
    },
    "10_trunk_twist": {
      "segments": [
        {
          "t": 0.0,
          "dur": 1.575,
          "text": "动作二：体转运动。"
        },
        {
          "t": 2.65,
          "dur": 4.475,
          "text": "体转运动可以有效地活动我们的腰腹部的肌肉。"
        },
        {
          "t": 8.7,
          "dur": 2.075,
          "text": "接下来请看动作示范。"
        },
        {
          "t": 13.09,
          "dur": 26.78,
          "text": "（跟随教练示范完成体转运动）"
        },
        {
          "t": 41.46,
          "dur": 2.825,
          "text": "在我们做这个动作时要注意，"
        },
        {
          "t": 45.04,
          "dur": 3.3,
          "text": "我们的腿部迈开后应与肩同宽。"
        },
        {
          "t": 49.18,
          "dur": 5.025,
          "text": "体转时，我们的双手应紧紧掐住我们的腰部，"
        },
        {
          "t": 55.03,
          "dur": 3.825,
          "text": "并且我们的体转度数大约为90°。"
        }
      ]
    },
    "11_lunge_stretch": {
      "segments": [
        {
          "t": 1.0,
          "dur": 10.15,
          "text": "弓步压腿分为正压腿和侧压腿，这个动作可以活动我们腿部的大部分肌肉，是十分有效的热身方式。"
        },
        {
          "t": 11.97,
          "dur": 1.85,
          "text": "接下来请看动作示范。"
        },
        {
          "t": 15.72,
          "dur": 23.3,
          "text": "（跟随教练示范完成弓步压腿）"
        },
        {
          "t": 39.56,
          "dur": 2.55,
          "text": "弓步压腿以四个八拍为一组，做4组即可有效热身。"
        },
        {
          "t": 43.38,
          "dur": 2.325,
          "text": "在我们做这个动作时要注意，"
        },
        {
          "t": 46.6,
          "dur": 3.15,
          "text": "弓步压腿是一个动态拉伸的过程，"
        },
        {
          "t": 50.54,
          "dur": 3.875,
          "text": "在全程要保证我们的腿部有紧迫感。"
        }
      ]
    },
    "12_turning": {
      "segments": [
        {
          "t": 0.38,
          "dur": 7.9,
          "text": "在滑雪时，如果可以控制滑行方向，就可以很大程度避免雪场上人与人之间的碰撞。"
        },
        {
          "t": 8.43,
          "dur": 7.6,
          "text": "其实控制滑行方向非常简单：当我们想转弯时，身体重心应保持在身体中间，身体可以向想转弯的方向微微侧倾。"
        },
        {
          "t": 16.81,
          "dur": 20.87,
          "text": "然后将我们的外侧腿，也就是山下腿——比如我们想往左边转时，右腿就是我们的外侧腿——将外侧腿微微发力，两板向想转弯的方向微微翘起，这样就可以转弯了。"
        },
        {
          "t": 37.98,
          "dur": 3.55,
          "text": "相信大家只要多尝试几次都可以学会。"
        },
        {
          "t": 42.19,
          "dur": 1.4,
          "text": "下面请看动作示范。"
        }
      ]
    },
    "13_pizza_stop": {
      "segments": [
        {
          "t": 0.29,
          "dur": 9.1,
          "text": "犁式刹车是最简单也是初学者最有效的控制刹车的方式：以足弓为轴打开板尾，让板头保持约一拳距离。"
        },
        {
          "t": 17.06,
          "dur": 3.15,
          "text": "尽量让两板向内侧翘起，"
        },
        {
          "t": 22.63,
          "dur": 4.625,
          "text": "同时身体上身保持正直，稍向前倾，"
        },
        {
          "t": 28.2,
          "dur": 17.15,
          "text": "一定不要向后方倒去，身体重心应放在身体的前侧，两臂自然伸直，雪杖微微点地，这样就可以有效地进行刹车了，这就是犁式刹车。"
        },
        {
          "t": 47.37,
          "dur": 1.9,
          "text": "下面我来为大家做动作示范。"
        }
      ]
    },
    "14_falling": {
      "segments": [
        {
          "t": 1.68,
          "dur": 8.7,
          "text": "当我们在滑雪时，如果技术不熟练停不下来时，一定要主动摔倒，可以极大程度地避免摔伤骨折。"
        },
        {
          "t": 10.88,
          "dur": 12.375,
          "text": "下面我就来为大家演示科学的摔倒动作：摔倒前一定要降低重心，注意身体不要向后仰，而后向侧后方摔倒。"
        },
        {
          "t": 24.25,
          "dur": 8.85,
          "text": "摔倒时应臀部先着地，而后是后背，也可以把双脚提起，切记不要翻滚。"
        },
        {
          "t": 43.49,
          "dur": 1.875,
          "text": "这就是正确的摔倒方式。"
        }
      ]
    },
    "20_muscle_strain": {
      "segments": [
        {
          "t": 0.3,
          "dur": 12.6,
          "text": "滑雪时为了完成各种动作，肌肉猛烈地收缩，超过了肌肉本身的负荷能力，或者超过了其伸展性，都可能会导致肌肉拉伤。"
        },
        {
          "t": 13.8,
          "dur": 7.975,
          "text": "肌肉拉伤是所有运动损伤中最频繁也是最容易发生的，相信每个人都经历过。"
        },
        {
          "t": 23.04,
          "dur": 9.85,
          "text": "在平时长期的不运动，以及滑雪前不做科学的热身运动，都会导致滑雪时发生肌肉拉伤。"
        },
        {
          "t": 33.68,
          "dur": 6.725,
          "text": "那么我也为大家总结出了以下几种科学的应对方法来供大家学习。"
        }
      ]
    },
    "21_joint_sprain": {
      "segments": [
        {
          "t": 0.0,
          "dur": 10.025,
          "text": "滑雪是一项富有刺激性的活动，在摔倒时，出于自我保护的本能反应，人的关节部位极容易首先着地，这就会造成人体的关节扭伤。"
        },
        {
          "t": 14.0,
          "dur": 13.41,
          "text": "关于预防滑雪时导致人体的关节扭伤，主要是针对我们的肘关节、髋关节、膝关节和我们的踝关节，尤其是初学者。"
        },
        {
          "t": 30.5,
          "dur": 9.85,
          "text": "而通过佩戴专业的护具和滑雪前的关节热身，可以有效地避免关节扭伤。下面我就来教给大家。"
        }
      ]
    },
    "22_fracture": {
      "segments": [
        {
          "t": 0.0,
          "dur": 4.275,
          "text": "滑雪时最应该注意预防的运动损伤就是骨折。"
        },
        {
          "t": 5.08,
          "dur": 4.275,
          "text": "因为它会对人的正常生活造成极大的影响，"
        },
        {
          "t": 10.26,
          "dur": 6.025,
          "text": "并且如果处理不及时，可能会遗留有不同程度的后遗症。"
        },
        {
          "t": 17.33,
          "dur": 4.6,
          "text": "所以在滑雪时一定要保持注意力集中，"
        },
        {
          "t": 22.66,
          "dur": 1.95,
          "text": "保持谨慎的滑雪心态，"
        },
        {
          "t": 25.44,
          "dur": 3.9,
          "text": "千万要保持滑雪速度，不能过快。"
        },
        {
          "t": 30.87,
          "dur": 6.55,
          "text": "那么我将教给大家以下几种滑雪技巧，可以有效地避免骨折的发生。"
        },
        {
          "t": 38.2,
          "dur": 2.175,
          "text": "技巧一：学习如何摔倒。"
        },
        {
          "t": 41.24,
          "dur": 2.3,
          "text": "技巧二：学习如何刹车。"
        },
        {
          "t": 44.3,
          "dur": 2.4,
          "text": "技巧三：学习如何控制方向。"
        },
        {
          "t": 47.92,
          "dur": 2.15,
          "text": "那么大家想学习哪一种呢？"
        }
      ]
    },
    "23_frostbite": {
      "segments": [
        {
          "t": 0.0,
          "dur": 4.175,
          "text": "冻伤是神经末梢的局部炎症性皮肤损伤。"
        },
        {
          "t": 5.46,
          "dur": 9.85,
          "text": "初期的冻伤会导致身体发红、发紫或肿胀，严重的可能会出现感染、休克等问题。"
        },
        {
          "t": 15.66,
          "dur": 14.15,
          "text": "众所周知，滑雪项目一般都在雪山中进行，其环境温度一般在零下10到20度左右。由于外部的寒冷环境或者是特别突然的降温，极易使人体冻伤。"
        },
        {
          "t": 30.68,
          "dur": 10.115,
          "text": "在我们滑雪的过程中，冻伤集中发生在人的脸部、耳部、脚踝和躯干。"
        }
      ]
    },
    "24_frostbite_face": {
      "segments": [
        {
          "t": 0.1,
          "dur": 5.8,
          "text": "搭配套头式的护脸和合适大小的雪镜，可以有效防止脸部冻伤。"
        },
        {
          "t": 7.27,
          "dur": 3.1,
          "text": "此外，在护脸和雪镜的接缝处，"
        },
        {
          "t": 11.51,
          "dur": 4.8,
          "text": "大家也可以贴上防风贴，以防止接缝处的冻伤。"
        },
        {
          "t": 17.42,
          "dur": 4.15,
          "text": "以上几种方式就可以有效防止脸部发生冻伤。"
        }
      ]
    },
    "25_frostbite_torso": {
      "segments": [
        {
          "t": 0.0,
          "dur": 9.8,
          "text": "很多朋友选择穿羽绒服或者是非专业的雪服去滑雪，这种装备很难抵挡高速滑行中的刺骨寒风，因此，选择专业的滑雪服是非常必要的。"
        },
        {
          "t": 15.56,
          "dur": 5.825,
          "text": "其次，在选择雪裤时，应选择这种带有背带的裤子，"
        },
        {
          "t": 22.88,
          "dur": 8.55,
          "text": "它可以防止我们在滑雪时如果摔倒，雪灌进衣服内，从而导致躯干的冻伤。"
        },
        {
          "t": 32.33,
          "dur": 17.7,
          "text": "在我们滑雪时选择内衣，应选择我身上穿的这种莱卡的或者是不吸汗的运动面料，而不应该选择我们日常生活中所穿的纯棉的、带有弹性的吸汗的一些生活面料。"
        },
        {
          "t": 51.06,
          "dur": 7.525,
          "text": "选择正确的穿搭方法和选择正确的着装，就可以有效地避免我们身体躯干的冻伤。"
        }
      ]
    },
    "26_frostbite_ankle": {
      "segments": [
        {
          "t": 0.35,
          "dur": 1.125,
          "text": "在滑雪时，"
        },
        {
          "t": 2.34,
          "dur": 5.65,
          "text": "如果我们意外摔倒，踝部可能会裸露在雪地表面，从而造成冻伤。"
        },
        {
          "t": 8.49,
          "dur": 11.275,
          "text": "因此，我们在穿雪鞋时，要把雪裤的内层紧紧地塞进雪鞋里扎紧，然后再把外层放下，这就可以有效地防止踝部的冻伤。"
        }
      ]
    },
    "99_outro": {
      "segments": [
        {
          "t": 0.08,
          "dur": 9.725,
          "text": "“带动三亿人参与冰雪运动”是习近平总书记的谆谆嘱托，也是中国向国际社会作出的郑重承诺。"
        },
        {
          "t": 10.75,
          "dur": 9.25,
          "text": "恭喜你已经完成了全部内容，相信初学滑雪的你一定可以在雪场上更好地保护自己。"
        },
        {
          "t": 20.58,
          "dur": 2.25,
          "text": "快去属于你的雪道上驰骋吧。"
        }
      ]
    }
  },
